  "name": "Dev Arcade",
  "theme": "willow",
  "colors": {
    "primary": "#b14cff",
    "light": "#b6ff3c",
    "dark": "#07060d"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/apursley2012/dev-arcade"
    }
  },
  "footer": {
